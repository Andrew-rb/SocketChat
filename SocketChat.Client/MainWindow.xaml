<Window x:Class="SocketChat.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SocketChat.Client"
        mc:Ignorable="d"
        Title="SocketChat" Height="600" Width="800">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Server IP" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox Name="RemoteIpBox" Text="127.0.0.1"/>

            <TextBlock Text="Server TCP Port" FontWeight="Bold" Margin="0,10,0,2"/>
            <TextBox Name="RemotePortBox" Text="5000"/>

            <TextBlock Text="User IP" FontWeight="Bold" Margin="0,10,0,2"/>
            <TextBox Name="LocalIpBox" Text="127.0.0.2" ToolTip="Укажите свой локальный IP (например, 127.0.0.2)"/>

            <TextBlock Text="User TCP Port" FontWeight="Bold" Margin="0,10,0,2"/>
            <TextBox Name="LocalPortBox" Text="6000" ToolTip="Фиксированный порт, под которым клиент будет виден в Wireshark"/>

            <TextBlock Text="Username" FontWeight="Bold" Margin="0,10,0,2"/>
            <TextBox Name="UserBox" Text="User1"/>

            <Button Content="Подключиться" Click="Connect_Click" Margin="0,20,0,0" Padding="5"/>
            <Button Content="Отключиться" Click="Disconnect_Click" Margin="0,5,0,0" Padding="5"/>

            <TextBlock Text="Пользователи" FontWeight="Bold" Margin="0,20,0,5"/>
            <ListBox ItemsSource="{Binding Users}" Height="200"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Чат" FontWeight="Bold" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding Messages}" Height="400"/>

            <TextBox Name="MessageBox" Margin="0,10,0,5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
            <Button Content="Отправить сообщение" Click="Send_Click" Padding="5" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>